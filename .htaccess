<IfModule mod_rewrite.c>
    Options +SymLinksIfOwnerMatch
    RewriteEngine On

    # Allow Installatron requests (Ini kita biarkan, untuk sistem hosting)
    RewriteCond %{REQUEST_FILENAME} deleteme\.\w+\.php
    RewriteRule (.*) - [L] 

    # Aturan baru untuk mengarahkan semua request ke folder /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>